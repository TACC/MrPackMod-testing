################################################################
####
#### Regression tests for Kokkos, OpenMP mode
####
################################################################

PACKAGE = kokkos
PACKAGEVERSION = 5.2.1-omp
MODE = omp
NONMODULES = cuda

EXISTENCETEST = --title "header" --dir inc Kokkos_Core.hpp

CMAKETEST = --title "compile and run" --ldd -r enabled-omp.cxx

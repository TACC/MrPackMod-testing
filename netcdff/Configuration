##
## Regression tests for netcdf, Fortran version
## using MrPackMod
## This file is only for private/separate installations;
## in production C & Fortran are mixed
##

PACKAGE = netcdff
PACKAGEVERSION = 4.6.4
MODE = seq

# in production netcdf & netcdff are separate modules,
# so we need to load netcdf explicitly
MODULES = netcdf

# Fortran tests are done separately in dev, but jointly in production
include ../netcdf/Configuration.seq_fortran

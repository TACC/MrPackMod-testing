PACKAGE = petsc
PACKAGEVERSION = 3.25
MODE = mpi

EXISTENCETEST = \
	--title "petsc.pc" \
	--dir lib pkgconfig/PETSc.pc
EXISTENCETEST = \
	--title "libpetsc.so" \
	--ldd \
	--dir lib libpetsc.so

#
# C tests
#
CMAKETEST = \
	--title "Sanity test" \
	sanity.c
PACKAGEVERSION*=debug   CMAKETEST = --title "Debug enabled"  debug1.c
PACKAGEVERSION~=debug   CMAKETEST = --title "Debug disabled" debug0.c

PACKAGEVERSION*=complex CMAKETEST = --title "has complex"    complex.c

#
# Kokkos
#
CMAKETEST = \
	  --title "have kokkos" \
	  have_kokkos.c

CMAKETEST = \
	  --title "ksp19 kokkos" \
	  --run_args "-ksp_type cg -pc_type bjkokkos -pc_bjkokkos_ksp_max_it 60 -pc_bjkokkos_ksp_type tfqmr -pc_bjkokkos_pc_type jacobi -pc_bjkokkos_ksp_rtol 1e-3 -mat_type aijkokkos" \
	  --value seqaijkokkos \
	  ksp19kokkos.c
	  
#
# Fortran
#
PACKAGEVERSION*=f08 \
CMAKETEST = \
	  --title "can we compile Fortran1990" \
	  fortran1990.F90

PACKAGEVERSION~=f08 \
CMAKETEST = \
	  --title "can we compile Fortran2008" \
	  fortran2008.F90


return
## if [[ "${PETSC_ARCH}" = *single* ]] ; then
##     realsize=4 ; else realsize=8 ; fi
## if [[ "${PETSC_ARCH}" = *complex* ]] ; then
##     realsize=$(( realsize * 2 )) ; fi
REALSIZE = 8
CMAKETEST = \
	--title "size of scalar" \
	--run -t ${REALSIZE} \
	scalar.c
## if [[ "${PETSC_ARCH}" = *i64* ]] ; then
##     intsize=8 ; else intsize=4 ; fi
INTSIZE = 4
CMAKETEST = \
	--title "size of int" \
	--run -t ${INTSIZE} \
	int.c
